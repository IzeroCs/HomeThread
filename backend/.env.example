# HTTP server (static addon bundle, Socket.io, CoAP).
# Default 4000 — matches Namorix Desktop addon baseUrl.
PORT=4000

# Namorix Desktop Vite dev origin (CORS + Socket.io).
# DESKTOP_ORIGIN=http://localhost:5173

# Optional: override path to Vite build output (default: dist/addon).
# ADDON_STATIC_DIR=/absolute/path/to/frontend/dist/addon

# BR connection: cấu hình qua frontend (Settings → BR Connection), lưu SQLite.
# Optional: BACKEND_IPV6, SRP_HOSTNAME, SRP_PORT cho SRP register khi BR là leader/router.
