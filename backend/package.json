{
  "name": "backend",
  "private": true,
  "version": "0.0.1",
  "description": "API + TCP cho OpenThread BR (frame protocol)",
  "main": "dist/index.js",
  "engines": { "node": "20.x" },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc && tsc-alias -p tsconfig.json && cp -r src/database/migrations dist/database/ 2>/dev/null || true",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@namorix/core-backend": "file:../../namorix/core/backend",
    "@namorix/core-shared": "file:../../namorix/core/shared",
    "better-sqlite3": "^11.7.0",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.38.0",
    "coap": "^1.0.1",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "shared": "file:../shared",
    "socket.io": "^4.7.5",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "drizzle-kit": "^0.30.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
