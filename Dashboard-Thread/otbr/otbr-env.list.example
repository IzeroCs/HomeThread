# Copy thành otbr-env.list và sửa theo máy của bạn.
# cp otbr-env.list.example otbr-env.list
#
# RCP theo by-id (ls /dev/serial/by-id/ khi RCP đang cắm) — không cần cắm RCP lúc start container
OT_RCP_DEVICE=spinel+hdlc+uart:///dev/serial/by-id/usb-1a86_USB_Single_Serial_579B026391-if00?uart-baudrate=460800
# Interface backhaul (Wi‑Fi hoặc Ethernet trên host)
OT_INFRA_IF=wlan0
# Interface Thread (otbr-agent tạo, thường wpan0)
OT_THREAD_IF=wpan0
OT_LOG_LEVEL=7
