# Backend (Dashboard-Thread) — context: Dashboard-Thread root.
# Mai này có thể thêm Dockerfile.frontend, build chung qua docker-compose.

FROM node:20-bookworm-slim

WORKDIR /app

ENV NODE_ENV=production
ENV PORT=3000

# Root + workspaces
COPY package.json package-lock.json* ./
COPY backend/package.json backend/
COPY backend/tsconfig.json backend/
COPY backend/src backend/src
COPY shared/package.json shared/
COPY shared/src shared/src

RUN npm ci --ignore-scripts 2>/dev/null || npm install --ignore-scripts
RUN npm rebuild better-sqlite3 2>/dev/null || true

RUN mkdir -p /app/data

EXPOSE 3000
EXPOSE 5683/udp

CMD ["npx", "tsx", "backend/src/index.ts"]
