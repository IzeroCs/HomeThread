{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "lib": ["ES2022"],
    "outDir": "dist",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@utils/*": ["src/utils/*"],
      "@cbor": ["src/cbor"],
      "@cbor/*": ["src/cbor/*"],
      "@database": ["src/database"],
      "@database/*": ["src/database/*"],
      "@communicate": ["src/communicate"],
      "@communicate/*": ["src/communicate/*"],
      "@coap/*": ["src/coap/*"],
      "@settings/*": ["src/settings/*"],
      "@thread/*": ["src/thread/*"],
      "@websocket/*": ["src/websocket/*"]
    },
    "strict": true,
    "experimentalDecorators": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
