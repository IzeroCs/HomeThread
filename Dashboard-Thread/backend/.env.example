# WebSocket Server Configuration
PORT=8080

# ot-ctl Configuration (binary in backend/tools when running from backend/)
OT_CTL_PATH=./tools/ot-ctl
# Socket path for ot-daemon. Leave empty to use default (/var/run/ot-daemon)
OT_CTL_SOCKET_PATH=
# If ot-ctl requires sudo, set to true
OT_CTL_USE_SUDO=false

# ot-daemon (spawned by backend for start/stop)
OT_DAEMON_PATH=./tools/ot-daemon
# Run ot-daemon with sudo (needed for serial port access unless udev rules set)
OT_DAEMON_USE_SUDO=true
# -v: ot-daemon logs to stdout (we pipe to backend logger for monitoring)
OT_DAEMON_VERBOSE=false
OT_DAEMON_DEFAULT_DEVICE=/dev/ttyACM0
OT_DAEMON_DEFAULT_BAUDRATE=460800

# Authentication (Optional)
AUTH_TOKEN=

# Logging
LOG_LEVEL=info
# Options: error, warn, info, debug

# Environment
NODE_ENV=development
