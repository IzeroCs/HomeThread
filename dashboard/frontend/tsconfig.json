{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@features/*": ["src/features/*"],
      "@shared/*": ["src/shared/*"],
      "@components/*": ["src/features/components/*"],
      "@monitor/*": ["src/features/monitor/*"],
      "@nodes/*": ["src/features/monitor/nodes/*"],
      "@joiner/*": ["src/features/monitor/joiner/*"],
      "@settings/*": ["src/features/settings/*"],
      "@status/*": ["src/features/monitor/status/*"],
      "@topology/*": ["src/features/monitor/topology/*"]
    },
    "target": "ES2020",
    "useDefineForClassFields": false,
    "experimentalDecorators": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": ["src"]
}
