menu "ESP Thread Border Router"

config LED_STATUS_ENABLE
    bool "Bật LED trạng thái RGB WS2812 (disabled=đỏ nhấp nháy, detached=xanh dương nhấp nháy, leader=xanh lá tĩnh, router=tím tĩnh, child=xanh dương tĩnh)"
    default y
    help
        LED WS2812/WS2812B addressable RGB LED trên ESP32-S3.
        ESP32-S3 DevKitC-1: GPIO 48 (onboard LED) hoặc GPIO 5 (external LED).

config LED_STATUS_GPIO
    int "GPIO cho LED RGB data (WS2812)"
    depends on LED_STATUS_ENABLE
    default 48
    range 0 48
    help
        GPIO pin cho data line của WS2812/WS2812B LED.
        ESP32-S3 DevKitC-1: GPIO 48 cho onboard LED, GPIO 5 cho external LED.

config BR_ETH_W5500_ENABLE
    bool "Bật Ethernet W5500 (backhaul ưu tiên, SPI)"
    default y
    select ETH_USE_SPI_ETHERNET
    select ETH_SPI_ETHERNET_W5500
    help
        BR dùng W5500 qua SPI làm backhaul (chỉ LAN, không Wi-Fi). ESP32-S3 không có EMAC.

if BR_ETH_W5500_ENABLE
    config BR_ETH_SPI_HOST
        int "SPI host cho W5500"
        range 0 2
        default 2
        help
            SPI2 thường dùng để tránh conflict UART RCP (SPI1 có thể dùng cho flash).

    config BR_ETH_SPI_SCLK_GPIO
        int "W5500 SCLK GPIO"
        default 12
        help
            ESP32-S3: 12 gợi ý cho SPI2.

    config BR_ETH_SPI_MOSI_GPIO
        int "W5500 MOSI GPIO"
        default 11

    config BR_ETH_SPI_MISO_GPIO
        int "W5500 MISO GPIO"
        default 13

    config BR_ETH_SPI_CS_GPIO
        int "W5500 CS GPIO"
        default 10

    config BR_ETH_SPI_CLOCK_MHZ
        int "SPI clock (MHz)"
        range 5 40
        default 20

    config BR_ETH_INT_GPIO
        int "W5500 INT GPIO (-1 = polling)"
        default -1
        help
            -1 để dùng polling (tránh conflict GPIO).

    config BR_ETH_POLLING_MS
        int "W5500 polling period (ms, khi INT=-1)"
        default 20
        help
            Chu kỳ poll khi không dùng interrupt; bỏ qua khi dùng INT.

    config BR_ETH_LINK_TIMEOUT_MS
        int "Timeout chờ IP trên Ethernet (ms)"
        default 15000
        help
            Chờ có IPv4 (DHCP) hoặc IPv6 (link-local/RA). Cắm trực tiếp BR-backend link có thể lên ~4–5s, IPv6 event sau đó; nên >= 10s.
endif

config BR_FRAME_TCP_PORT
    int "Port TCP cho kênh frame (BR listen)"
    default 5000
    range 1 65535
    help
        BR listen trên port này; dashboard kết nối tới BR_IP:port để gửi/nhận frame.

endmenu
