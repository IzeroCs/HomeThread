# Mac dinh: Full Thread Device (FTD) + Joiner - co the thang cap len Router
CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_JOINER=y

# Custom OpenThread config: Child timeout, Child supervision (sua trong openthread_custom_config.h)
CONFIG_OPENTHREAD_HEADER_CUSTOM=y
CONFIG_OPENTHREAD_CUSTOM_HEADER_PATH=""
CONFIG_OPENTHREAD_CUSTOM_HEADER_FILE_NAME="openthread_custom_config.h"

    # OpenThread CLI extension (heapdiag, ip, loglevel, ota, tcp/udp, wifi, ...)
CONFIG_OPENTHREAD_CLI_ESP_EXTENSION=y

# mbedTLS: ECJPAKE + DTLS can cho Thread commissioning (Joiner handshake)
CONFIG_MBEDTLS_ECJPAKE_C=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT=y

CONFIG_OPENTHREAD_DNS_CLIENT=y
