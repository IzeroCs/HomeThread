# namorix-thread — dev ports (safe to commit; no secrets).
# Run alongside namorix Desktop: Desktop uses PORT=3000 + DESKTOP_VITE_PORT=5173 (see that repo’s .env).
#
# PORT               — Thread Express (API, addon static, Socket.io for dashboard)
# THREAD_VITE_PORT   — Thread dashboard Vite dev (5180 avoids clashing with Desktop 5173)
# DESKTOP_ORIGIN     — Browser origin of Namorix Desktop shell (must match namorix CORS)

PORT=4000
THREAD_VITE_PORT=5180
DESKTOP_ORIGIN=http://localhost:5173
