# Example light_on_off: Full Thread Device (FTD) + Joiner
# Partition: factory 1.5MB
CONFIG_PARTITION_TABLE_CUSTOM=y

# sys_evt (default event loop) chạy handler OpenThread (update_attached_led_role, log_leader_data)
# cần stack lớn hơn mặc định (OT lock + ESP_LOGI) — tránh Stack protection fault
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_OPENTHREAD_ENABLED=y
CONFIG_OPENTHREAD_FTD=y
CONFIG_OPENTHREAD_JOINER=y

# Custom OpenThread config (file o thu muc goc project)
CONFIG_OPENTHREAD_HEADER_CUSTOM=y
CONFIG_OPENTHREAD_CUSTOM_HEADER_PATH="../.."
CONFIG_OPENTHREAD_CUSTOM_HEADER_FILE_NAME="openthread_custom_config.h"

# mbedTLS: ECJPAKE + DTLS cho Thread commissioning (Joiner handshake)
CONFIG_MBEDTLS_ECJPAKE_C=y
CONFIG_MBEDTLS_KEY_EXCHANGE_ECJPAKE=y
CONFIG_MBEDTLS_SSL_PROTO_DTLS=y
CONFIG_MBEDTLS_TLS_SERVER_AND_CLIENT=y

CONFIG_OPENTHREAD_DNS_CLIENT=y
